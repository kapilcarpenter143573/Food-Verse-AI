# ============================================================
# Food Verse AI – Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file. Variables starting with VITE_
# are embedded in the frontend build – do NOT put secrets here.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# App display name
VITE_APP_NAME=Food Verse AI

# Set to true to force demo mode in the UI even if backend is available
VITE_DEMO_MODE=false
