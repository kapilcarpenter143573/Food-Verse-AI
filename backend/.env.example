# ============================================================
# Food Verse AI – Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to version control.

# -------------------------------------------------------
# Application Settings
# -------------------------------------------------------
APP_ENV=development
DEBUG=true
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------
# Google Cloud / Gemini AI (Primary AI Provider)
# -------------------------------------------------------
# Get your API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: if using Vertex AI instead of AI Studio
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# -------------------------------------------------------
# AI Model Selection
# -------------------------------------------------------
# Supported values: gemini  (more providers can be added)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------------------
# Demo Mode (set to true if no AI credentials are available)
# -------------------------------------------------------
# When DEMO_MODE=true the app returns clearly labelled sample data.
# Sample data is NOT real AI output. Never present it as such.
DEMO_MODE=false

# -------------------------------------------------------
# File Upload
# -------------------------------------------------------
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
UPLOAD_DIR=uploads
